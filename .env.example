# AV Nexus North Star: Deliver production-grade "Command Center" navigation, per our roadmap.

# ==============================================================================
# Backend / runtime
# ==============================================================================

# App context ------------------------------------------------------------------
APP_NAME=AV Nexus
# development | production
ENV=development
# API prefix used by every route
API_PREFIX=/api/v1

## Database -------------------------------------------------------------------
# Development default is a local SQLite file. Production should use Postgres, e.g.
#AVNEXUS_DB_URL=postgresql+psycopg://avnexus:avnexus@postgres:5432/avnexus
AVNEXUS_DB_URL=sqlite:///./avnexus.db
# Log SQL statements (dev)
AVNEXUS_DB_ECHO=false

## Security ------------------------------------------------------------------
# CHANGE THIS in any non-local environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AVNEXUS_JWT_SECRET=dev-only-change-me
AVNEXUS_JWT_ALGORITHM=HS256
# Access-token lifetime in minutes (default 12h)
AVNEXUS_JWT_EXPIRY_MINUTES=720

## LLM provider ---------------------------------------------------------------
# "off" -> deterministic agents only (default, works offline)
# "openai" -> real LLM generation via the OpenAI-compatible HTTP API
AVNEXUS_LLM_PROVIDER=off
# NEVER commit a real key. Provide at runtime via env / secrets manager.
AVNEXUS_LLM_API_KEY=
AVNEXUS_LLM_MODEL=gpt-4o-mini
AVNEXUS_LLM_BASE_URL=https://api.openai.com/v1
AVNEXUS_LLM_TIMEOUT_SECONDS=60

## Demo seed ------------------------------------------------------------------
# Bootstraps a demo chairman org + 3 companies on first startup (idempotent).
AVNEXUS_SEED_DEMO=true
AVNEXUS_DEMO_ORG_NAME=AV Holding (Demo)
AVNEXUS_DEFAULT_ORG_NAME=Artiswon

## Limits --------------------------------------------------------------------
# Execution guardrails (never shipped as run-as-fast-as-possible knobs).
AVNEXUS_MAX_TASKS_PER_RUN=20
AVNEXUS_AGENT_RETRIES=2